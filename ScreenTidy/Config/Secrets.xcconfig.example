// ScreenTidy/Config/Secrets.xcconfig.example
// Copy to Secrets.xcconfig (gitignored) and fill after Railway deploy.
// Never commit real tokens or OpenAI keys.

// Railway public HTTPS URL (no trailing slash). xcconfig requires escaping // as /$()/
SCREENTIDY_GATEWAY_BASE_URL = https:/$()/YOUR_RAILWAY_HOST.up.railway.app

// Same value as Railway GATEWAY_SHARED_SECRET (NOT OPENAI_API_KEY)
SCREENTIDY_GATEWAY_TOKEN = replace_with_openssl_rand_hex_32
