# Server (Railway sets PORT automatically)
HOST=0.0.0.0
PORT=8787

# OpenAI — required for /v1/understand* (NEVER commit real values)
OPENAI_API_KEY=
# GPT-5.6 Terra initial product choice (replaceable without client changes)
OPENAI_MODEL=gpt-5.6-terra

# MVP/TestFlight gateway bearer token — NOT the OpenAI key.
# Required on Railway. Optional for local `npm run dev` (auth disabled when empty).
GATEWAY_SHARED_SECRET=

# Request bounds
REQUEST_TIMEOUT_MS=60000
MAX_BATCH_SIZE=8
IMAGE_LONG_EDGE_MAX=1024

# Simple in-memory rate limit (per client IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Contract version advertised by GET /health and validated on requests
SCHEMA_VERSION=screentidy-understanding-v2
